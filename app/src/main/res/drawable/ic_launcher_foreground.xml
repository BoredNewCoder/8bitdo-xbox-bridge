<?xml version="1.0" encoding="utf-8"?>
<!-- Simple gamepad glyph: pill-shaped body, D-pad on the left, two face buttons on the
     right. Hand-built from basic geometric primitives (rect/circle path commands), not
     traced from any icon set, to keep this fully original artwork. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Pill-shaped controller body -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M40,38 L68,38 A16,16 0 0,1 68,70 L40,70 A16,16 0 0,1 40,38 Z" />

    <!-- D-pad (cross) -->
    <path
        android:fillColor="#14213D"
        android:pathData="M35,46 L41,46 L41,51 L46,51 L46,57 L41,57 L41,62 L35,62 L35,57 L30,57 L30,51 L35,51 Z" />

    <!-- Face buttons -->
    <path
        android:fillColor="#14213D"
        android:pathData="M65,44 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 Z" />
    <path
        android:fillColor="#14213D"
        android:pathData="M73,54 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 Z" />
</vector>
